<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net3.5</TargetFramework>
	<TargetFramework Condition="'$(Configuration)'=='IL2CPPRelease'">net6.0</TargetFramework>
    <Version>0.3.10-tw.1</Version>
    <AssemblyVersion>0.3.10.0</AssemblyVersion>
    <FileVersion>0.3.10.1</FileVersion>
    <XUnityReferenceDirectory Condition="'$(XUnityReferenceDirectory)' == '' And '$(Configuration)' == 'Release'">..\Libraries\XUnity.AutoTranslator-Developer-5.4.4</XUnityReferenceDirectory>
    <XUnityReferenceDirectory Condition="'$(XUnityReferenceDirectory)' == '' And '$(Configuration)' == 'IL2CPPRelease'">..\Libraries\XUnity.AutoTranslator-Developer-IL2CPP-5.4.4</XUnityReferenceDirectory>
    <Configurations>Release;IL2CPPRelease</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='IL2CPPRelease|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\OpenCC\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="XUnity.AutoTranslator.Plugin.Core" Condition="'$(Configuration)'=='Release'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.AutoTranslator.Plugin.Core.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.AutoTranslator.Plugin.ExtProtocol" Condition="'$(Configuration)'=='Release'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.AutoTranslator.Plugin.ExtProtocol.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.Common" Condition="'$(Configuration)'=='Release'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.Common.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.ResourceRedirector" Condition="'$(Configuration)'=='Release'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.ResourceRedirector.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.AutoTranslator.Plugin.Core" Condition="'$(Configuration)'=='IL2CPPRelease'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.AutoTranslator.Plugin.Core.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.AutoTranslator.Plugin.ExtProtocol" Condition="'$(Configuration)'=='IL2CPPRelease'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.AutoTranslator.Plugin.ExtProtocol.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.Common" Condition="'$(Configuration)'=='IL2CPPRelease'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.Common.dll</HintPath>
    </Reference>
    <Reference Include="XUnity.ResourceRedirector" Condition="'$(Configuration)'=='IL2CPPRelease'">
      <HintPath>$(XUnityReferenceDirectory)\XUnity.ResourceRedirector.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
